{
  "name": "onebun",
  "version": "0.2.0",
  "author": "RemRyahirev",
  "description": "OneBun framework monorepo - A bun.js framework inspired by nest.js with effect.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RemRyahirev/onebun.git"
  },
  "bugs": {
    "url": "https://github.com/RemRyahirev/onebun/issues"
  },
  "homepage": "https://github.com/RemRyahirev/onebun#readme",
  "engines": {
    "bun": "1.2.12",
    "node": "24"
  },
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "ex1": "bun run examples/crud-api/src/index.ts",
    "ex2": "bun run examples/multi-service/src/index.ts",
    "ex3": "bun run examples/websocket-chat/src/index.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "bun test && bun test examples/",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "lint": "eslint --fix --max-warnings=0",
    "typecheck": "bunx tsc --noEmit && bun run typecheck:examples",
    "typecheck:examples": "bunx tsc --noEmit -p examples/crud-api && bunx tsc --noEmit -p examples/multi-service && bunx tsc --noEmit -p examples/websocket-chat",
    "publish:check": "bun scripts/publish.ts --dry-run",
    "publish:packages": "bun scripts/publish.ts",
    "version:bump": "bun scripts/version-bump.ts",
    "compose:up": "docker-compose -p onebun-example",
    "redis:cli": "docker-compose exec redis redis-cli -a $REDIS_PASSWORD",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:xref": "bun scripts/docs-xref.ts",
    "docs:typecheck": "bun scripts/docs-typecheck.ts",
    "skill:install": "bun scripts/install-skill.ts",
    "skill:check": "bun scripts/install-skill.ts --check",
    "readme:generate": "bun scripts/generate-readme.ts",
    "readme:check": "bun scripts/generate-readme.ts --check"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks/realistic/onebun",
    "benchmarks/realistic-pg/onebun",
    "benchmarks/realistic-pg/onebun-full",
    "!repofleet/**"
  ],
  "dependencies": {
    "effect": "^3.13.10"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "bun-types": "^1.3.8",
    "eslint": "^9.30.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "jiti": "^2.6.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.10.0"
  }
}
